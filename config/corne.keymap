#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <400>;
            flavor = "tap-preferred";
        };

        ht: ht {
            compatible = "zmk,behavior-hold-tap";
            label = "HT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD0";
            #binding-cells = <0>;
            bindings = <&ht DOT COMMA>, <&ht SEMI LS(SEMI)>;

            tapping-term-ms = <300>;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <16 15>;
            timeout-ms = <30>;
        };

        right_bkt {
            bindings = <&kp RBKT>;
            key-positions = <19 20>;
            timeout-ms = <30>;
        };

        left_par {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
            timeout-ms = <30>;
        };

        right_par {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <31 32>;
            timeout-ms = <30>;
        };

        left_brace {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 4>;
            timeout-ms = <30>;
        };

        right_brace {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <7 8>;
            timeout-ms = <30>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 6>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <17 18>;
        };

        less {
            bindings = <&kp LESS_THAN>;
            key-positions = <14 15>;
        };

        greater {
            bindings = <&kp GREATER_THAN>;
            key-positions = <21 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "BASE";
            bindings = <
&kp ESC     &kp Q     &kp W  &kp E     &kp R      &kp T    &kp Y  &kp U          &kp I       &kp O      &kp P      &kp SLASH
&kp LSHIFT  &kp A     &kp S  &kp D     &kp F      &kp G    &kp H  &kp J          &kp K       &kp L      &kp GRAVE  &kp ENTER
&kp LCTRL   &ltq 3 Z  &kp X  &kp C     &kp V      &kp B    &kp N  &kp M          &td0        &kp MINUS  &kp APOS   &kp LEFT_ALT
                             &kp LGUI  &kp SPACE  &kp TAB  &mo 1  &kp BACKSPACE  &ltq 2 DEL
            >;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&trans  &kp N1     &kp N2     &kp N3     &kp N4    &kp N5   &kp N6        &kp N7    &kp N8        &kp N9    &kp N0     &trans
&trans  &kp SLASH  &kp ASTRK  &kp MINUS  &kp PLUS  &kp DOT  &kp KP_EQUAL  &kp LEFT  &kp UP_ARROW  &kp DOWN  &kp RIGHT  &trans
&kp F1  &kp F2     &kp F3     &kp F4     &kp F5    &kp F6   &kp F7        &kp F8    &kp F9        &kp F10   &kp F11    &kp F12
                              &trans     &trans    &trans   &trans        &trans    &trans
            >;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans      &trans             &trans      &trans           &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &trans      &kp C_VOLUME_DOWN  &kp C_MUTE  &kp C_VOLUME_UP  &trans  &trans
&trans  &trans        &trans        &bt BT_CLR    &trans        &trans        &bt BT_NXT  &trans             &trans      &trans           &trans  &trans
                                    &trans        &trans        &trans        &trans      &trans             &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK       &mkp MCLK     &mkp RCLK       &trans           &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_UP  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans          &trans        &trans          &trans           &trans
                        &trans  &trans  &trans  &trans  &trans          &trans
            >;
        };
    };
};
